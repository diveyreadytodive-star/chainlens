{
  "manifest_version": 3,
  "name": "ChainLens",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "온체인 거래 해시를 근거 중심의 한국어 영수증으로 해석합니다. 현재 Ethereum Mainnet을 지원합니다.",
  "icons": {
    "16": "icons/chainlens-16.png",
    "32": "icons/chainlens-32.png",
    "48": "icons/chainlens-48.png",
    "128": "icons/chainlens-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://chainlens-lyart.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChainLens로 현재 거래 해석",
    "default_icon": {
      "16": "icons/chainlens-16.png",
      "32": "icons/chainlens-32.png",
      "48": "icons/chainlens-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/quick-receipt.css"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
